DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# A separate migration account; the running app uses a DML-only account.
MIGRATION_DATABASE_URL=
GATEWAY_SECRET=
OWNER_EMAIL=
SITE_URL=https://YOUR-FRONTEND
PRIVATE_SITE=true
PORT=5196
# GATEWAY_SECRET must match the separate frontend gateway server secret.
# DEV_DATABASE=true / DEV_USER_ID / DEV_USER_EMAIL are localhost-only test settings; never set on production.

# Optional official FAQ guide; model and limits are managed by the Owner.
# No key or long-term conversation is stored in content records.
ANTHROPIC_API_KEY=

# A stable server-only random secret (at least 32 characters) for anonymous reaction cookies.
# Never publish this value or put it in browser storage.
VISITOR_COOKIE_SECRET=
# Optional override; default relative to /app (Docker) or the project working directory.
SOURCE_PARSER_PATH=backend/source-parser.js
# Editorial scheduling, collection, AI model and budgets are stored in PostgreSQL.
# Initial settings: paused, MANUAL, collection/AI/scheduling OFF.

# Server-only AES-GCM token encryption key; stable random value, at least 32 chars.
MARKETING_ENCRYPTION_KEY=
# Private persistent storage, outside public/ and dist/. Back up together with DB.
MEDIA_ROOT=

# Local Windows testing only. Never enable LOCAL_POSTGRES on hosted infrastructure.
LOCAL_POSTGRES=false
LOCAL_AUTH_SECRET=
# Optional server-only private environment file for localhost account setup; default .env.
LOCAL_ENV_FILE=

# Optional official read/report connections. No keys are embedded in browser code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SITE/admin/oauth/callback
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=https://YOUR-SITE/admin/oauth/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR-SITE/admin/oauth/callback
GA4_ACCESS_TOKEN=
GSC_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
META_ADS_ACCESS_TOKEN=
NAVER_ADS_API_KEY=
NAVER_ADS_SECRET_KEY=
# Inquiry notifications additionally require the mail adapter/provider configuration.
MAIL_API_KEY=
MAIL_PROVIDER=
MAIL_FROM=

# URL-only administrator sign-in. Never store a plaintext admin password.
ADMIN_LOGIN_ID=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Existing active operator ID, not a new Owner registration.
ADMIN_USER_ID=
# Test-only defaults; never enable on production.
DEV_DATABASE=false
DEV_DATA_PATH=
DEV_USER_ID=
DEV_USER_EMAIL=
